<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Photo/Video Search Duplicate Copy And Divide Year/Month</Title>
    <Copyright>© 2026 G.L. aka Firefox_1998</Copyright>
    <PackageIcon>photography-icon.png</PackageIcon>
    <Description>This program search "duplicates" photo, video and copy in destination path dividing the files by year and month of shooting</Description>
    <Platforms>x64</Platforms>
    <StartupObject>PhotoMoveYearMonthFolder.Program</StartupObject>
    <AssemblyTitle>PhotoMoveYearMonthFolder</AssemblyTitle>
    <AssemblyCompany>G.L. aka Firefox_1998</AssemblyCompany>
    <AssemblyProduct>PhotoMoveYearMonthFolder</AssemblyProduct>
    <AssemblyCopyright>© 2025 G.L. aka Firefox_1998</AssemblyCopyright>
    <AssemblyDescription>This program search "duplicates" photo, video and copy in destination path dividing the files by year and month of shooting.</AssemblyDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Firefox-1998/PhotoVideoOrganizer</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <ApplicationIcon>photography-icon-Windows.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="photography-icon-Windows.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\photography-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\About.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>About.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\PhotoSearchMove.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PhotoSearchMove.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\About.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>About.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="frmAbout.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Logging.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\PhotoSearchMove.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <LastGenOutput>PhotoSearchMove.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="SetVersion" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <!-- Giorni dal 1/1/2000 -->
      <Build>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse("2000-01-01"))).Days)</Build>
  
      <!-- Secondi dall'inizio della giornata -->
      <Seconds>$([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds)</Seconds>
  
      <!-- Divisione per 2 e troncamento -->
      <Revision>$([System.Math]::Floor($([MSBuild]::Divide($(Seconds), 2))))</Revision>
  
      <!-- Versioni -->
      <AssemblyVersion>1.1.0.0</AssemblyVersion>
      <FileVersion>1.1.$(Build).$(Revision)</FileVersion>
      <Version>1.1.$(Build).$(Revision)</Version>
    </PropertyGroup>
  </Target>
</Project>